# QueryClip environment variables
# Copy this file to .env and fill in your credentials.
# Never commit the real .env file.

# Required: Groq API key for LLM inference
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required for ngrok static domain tunnelling
# Get your auth token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Optional: HuggingFace Hub token for higher rate limits when downloading models
# Without this, anonymous access is used (slower downloads, lower rate limits)
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=your_hf_token_here

# Optional: override the backend URL for the Streamlit app
# Leave blank to use the static ngrok domain automatically
# BACKEND_URL=https://great-repeatedly-alien.ngrok-free.app
